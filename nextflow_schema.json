{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/OWNER/cnmf/main/nextflow_schema.json",
    "title": "cNMF pipeline parameters",
    "description": "cNMF on UCL Myriad: subset -> topometry -> prep -> factorize -> combine, with consensus as a separate entry point",
    "type": "object",
    "$defs": {
        "input_output_options": {
            "title": "Input/output options",
            "type": "object",
            "properties": {
                "samplesheet": {
                    "type": ["string", "null"],
                    "format": "file-path",
                    "exists": true,
                    "schema": "assets/schema_input.json",
                    "pattern": "^\\S+\\.csv$",
                    "description": "CSV samplesheet, one row per run (counts, metadata, subset, k_vals, hvgs, run_name)"
                },
                "outdir": {
                    "type": "string",
                    "format": "directory-path",
                    "default": "${launchDir}/results_<run_date>",
                    "description": "Output directory; one sample folder per row (cnmf, topometry, hvgs, logs, pipeline_info)"
                }
            }
        },
        "cnmf_options": {
            "title": "cNMF options",
            "type": "object",
            "properties": {
                "seed": { "type": ["integer", "string"], "pattern": "^\\d+$", "default": 42, "description": "Random seed for cnmf prepare" },
                "k_vals": {
                    "type": "string",
                    "default": "20 30 40",
                    "pattern": "^\\d+([ ;]+\\d+)*$",
                    "description": "Default components (k) for rows with no k_vals in the samplesheet"
                },
                "n_iters": { "type": ["integer", "string"], "pattern": "^[1-9]\\d*$", "minimum": 1, "default": 100, "description": "Iterations per k, for rows with no n_iters column value" },
                "stride": { "type": ["integer", "string"], "pattern": "^[1-9]\\d*$", "minimum": 1, "default": 10, "description": "Factorize workers run per SGE task" },
                "run_date": { "type": "string", "pattern": "^\\d{8}$", "hidden": true, "description": "YYYYMMDD used in the default outdir and run names. Default: today" },
                "cluster_color": { "type": "string", "default": "ctype", "description": "obs column shown next to the clusterings in the cluster comparison plot; skipped if missing" },
                "trace_stamp": { "type": "string", "hidden": true, "description": "Timestamp naming this run's raw trace file. Default: now" },
                "step": { "type": "string", "enum": ["pipeline", "consensus", "analysis"], "default": "pipeline", "description": "pipeline: subset to combine. consensus: build consensus for --sample after inspecting the k selection plot. analysis: GEP analysis for --sample after consensus" }
            }
        },
        "consensus_options": {
            "title": "Consensus options (-entry consensus)",
            "type": "object",
            "properties": {
                "sample": { "type": ["string", "null"], "description": "Sample directory under outdir (the row tag, e.g. ctype_MEL)" },
                "run_name": { "type": ["string", "null"], "description": "Run name to build consensus for" },
                "selected_k": { "type": ["integer", "string", "null"], "pattern": "^([2-9]|[1-9]\\d+)$", "minimum": 2, "description": "Chosen number of components (k)" },
                "threshold": { "type": ["number", "string"], "pattern": "^\\d+(\\.\\d+)?$", "default": 2, "description": "Local density threshold" }
            }
        },
        "analysis_options": {
            "title": "Analysis options",
            "type": "object",
            "description": "For --step analysis (after consensus). Also uses sample, run_name, selected_k and threshold.",
            "properties": {
                "gmt": { "type": "string", "format": "file-path", "description": "GO biological process GMT (bin/fetch_resources.py)" },
                "collectri": { "type": "string", "format": "file-path", "description": "CollecTRI network parquet (bin/fetch_resources.py)" },
                "projection": { "type": "string", "default": "projection", "description": "obsm key of the embedding to plot on" },
                "clusters": { "type": "string", "default": "clusters", "description": "obs column with the cluster labels to use, e.g. topo_clusters_ms_res0.6 as chosen from clustree.png" },
                "age": { "type": "string", "default": "age_pretty", "description": "obs column with age labels" },
                "summary_cols": { "type": ["string", "null"], "description": "Columns for the projection summary; default: age, clusters and ctype_detailed. Missing ones are skipped" },
                "usage_cutoff": { "type": ["number", "string"], "pattern": "^\\d+(\\.\\d+)?$", "default": 0.1, "description": "Usage above which a cell counts as using a GEP" },
                "n_top_genes": { "type": ["integer", "string"], "pattern": "^[1-9]\\d*$", "default": 100, "description": "Top genes saved per GEP" },
                "geps_per_page": { "type": ["integer", "string"], "pattern": "^\\d+$", "default": 6, "description": "GEPs per page in the multi-GEP figures (0 = one page)" },
                "formats": { "type": "string", "default": "png,pdf", "description": "Figure formats, comma separated" }
            }
        },
        "institutional_config_options": {
            "title": "Institutional config options",
            "type": "object",
            "hidden": true,
            "properties": {
                "config_profile_description": { "type": "string", "hidden": true },
                "config_profile_contact": { "type": "string", "hidden": true },
                "config_profile_url": { "type": "string", "hidden": true }
            }
        }
    },
    "allOf": [
        { "$ref": "#/$defs/input_output_options" },
        { "$ref": "#/$defs/cnmf_options" },
        { "$ref": "#/$defs/consensus_options" },
        { "$ref": "#/$defs/analysis_options" },
        { "$ref": "#/$defs/institutional_config_options" }
    ]
}
