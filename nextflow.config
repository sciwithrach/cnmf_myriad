// cNMF pipeline. Run with: -profile ucl_myriad
// The profile (conf/ucl_myriad.config, from nf-core/configs) owns the executor, penv, clusterOptions
// (memory per core), scratch and the singularity/apptainer engine. Nothing here sets those, so the
// two files combine cleanly: conf/base.config only sets cpus / memory / time per resource label.

plugins {
    id 'nf-schema@2.5.1'   // samplesheet + parameter validation
}

params {
    samplesheet = null                       // required, see assets/schema_input.json
    run_date    = new Date().format('yyyyMMdd')
    trace_stamp = new Date().format('yyyyMMdd_HHmmss')   // names this run's raw trace file
    step        = 'pipeline'             // 'pipeline' (default), 'consensus' or 'analysis'
    outdir      = "${launchDir}/results_${params.run_date}"
    seed        = 42
    k_vals      = '20 30 40'                 // default, overridden per row by the samplesheet k_vals column
    n_iters     = 100
    stride      = 10                         // factorize workers per SGE task

    // cluster comparison plot (pipeline step, subset rows)
    cluster_color = 'ctype'                  // obs column shown next to the clusterings; skipped if missing

    // consensus step only (--step consensus)
    sample      = null                       // sample dir (the row tag, e.g. ctype_MEL)
    run_name    = null
    selected_k  = null
    threshold   = 2

    // analysis step only (--step analysis, after consensus; also uses sample, run_name, selected_k and threshold)
    gmt         = "${projectDir}/assets/resources/MOUSE_GO_bp_no_GO_iea_symbol.gmt"   // see bin/fetch_resources.py
    collectri   = "${projectDir}/assets/resources/collectri_mouse.parquet"
    projection  = 'projection'               // obsm key of the embedding to plot on
    clusters    = 'clusters'                 // obs column with the cluster labels to use; choose it from clustree.png, e.g. topo_clusters_ms_res0.6
    age         = 'age_pretty'               // obs column with age labels
    summary_cols = null                      // projection summary columns; default: age, clusters and ctype_detailed (missing ones are skipped)
    usage_cutoff = 0.1                       // usage above which a cell counts as using a GEP
    n_top_genes = 100
    geps_per_page = 6                        // GEPs per page in the multi-GEP figures (0 = one page)
    formats     = 'png,pdf'
}

includeConfig 'conf/base.config'

// Per-task resource usage, to compare against the requests in conf/base.config
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/trace_${params.trace_stamp}.txt"
    fields  = 'task_id,hash,native_id,process,tag,name,status,exit,submit,start,complete,duration,realtime,cpus,%cpu,memory,peak_rss,peak_vmem,rss,vmem,rchar,wchar'
}

profiles {
    ucl_myriad {
        includeConfig 'conf/ucl_myriad.config'
        executor.queueSize = 800    // per Nextflow run; the profile default is 100 (qsub max is ~1000)
    }
    test       { includeConfig 'conf/test.config' }
}
