// cNMF pipeline. Run with: -profile ucl_myriad
// The profile (conf/ucl_myriad.config, from nf-core/configs) owns the executor, penv, clusterOptions
// (memory per core), scratch and the singularity/apptainer engine. Nothing here sets those, so the
// two files combine cleanly: conf/base.config only sets cpus / memory / time per resource label.

plugins {
    id 'nf-schema@2.5.1'   // samplesheet + parameter validation
}

params {
    samplesheet = null                       // required, see assets/schema_input.json
    run_date    = new Date().format('yyyyMMdd')
    outdir      = "${launchDir}/results_${params.run_date}"
    seed        = 42
    k_vals      = '20 30 40'                 // default, overridden per row by the samplesheet k_vals column
    n_iters     = 100
    stride      = 10                         // factorize workers per SGE task

    // consensus entry point only
    sample      = null                       // sample dir (the row tag, e.g. ctype_MEL)
    run_name    = null
    selected_k  = null
    threshold   = 2
}

includeConfig 'conf/base.config'

// Per-task resource usage, to compare against the requests in conf/base.config
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/trace.txt"
    fields  = 'task_id,hash,native_id,process,tag,name,status,exit,submit,start,complete,duration,realtime,cpus,%cpu,memory,peak_rss,peak_vmem,rss,vmem,rchar,wchar'
}

profiles {
    ucl_myriad { includeConfig 'conf/ucl_myriad.config' }
    test       { includeConfig 'conf/test.config' }
}
