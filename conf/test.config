// Small run to check the setup: -profile ucl_myriad,test
params {
    samplesheet = "${projectDir}/assets/samplesheet_test.csv"
    outdir      = "${launchDir}/results_test"
    n_iters     = 2
    stride      = 2
}

process {
    withName: TOPOMETRY {
        cpus   = 4
        memory = 8.GB       // total; the ucl_myriad profile divides by cpus (2G per core)
        time   = 5.min
    }
}
