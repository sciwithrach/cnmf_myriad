// Small run to check the setup: -profile ucl_myriad,test
params {
    samplesheet = "${projectDir}/assets/samplesheet_test.csv"
    outdir      = "${launchDir}/results_test"
    n_iters     = 2
    stride      = 2
}

// nextflow.config evaluates trace.file before the profile sets outdir, so repoint it here
trace.file = "${params.outdir}/pipeline_info/trace.txt"

process {
    withName: TOPOMETRY {
        cpus   = 4
        memory = 4.GB       // total; the ucl_myriad profile divides by cpus (1G per core)
        time   = 5.min
    }
}
