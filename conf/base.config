// Resource labels, used by the modules. The ucl_myriad profile owns the executor, penv, clusterOptions
// (memory per core), scratch and the container engine, so only cpus / memory / time are set here.
// memory is the TOTAL for the task: the profile divides it by cpus to get the per-core request.

// anndata setting from scripts/include.sh. The env scope is exported inside the container by Nextflow,
// which a beforeScript export (or APPTAINERENV_ on the host) did not reliably do.
env {
    ANNDATA_ALLOW_WRITE_NULLABLE_STRINGS = '1'
}

process {
    // retry with scaled resources on OOM / walltime kills (137-140 SGE, 143-145 signals, 104) and on jobs SGE lost
    // (no exit status is read back: Integer.MAX_VALUE), else finish
    errorStrategy = { task.exitStatus in ((130..145) + 104 + Integer.MAX_VALUE) ? 'retry' : 'finish' }
    maxRetries    = 1

    withLabel: process_single {     // factorize: each task runs a stride of iterations
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 6.h * task.attempt }     // stride 10 x up to ~30 min per iteration, plus margin
    }
    withLabel: process_medium {     // subset, prep, combine: single-threaded; subset peaked at 1.1 GB, prep/combine at <= 0.5 GB
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 15.min * task.attempt }
    }
    withLabel: process_high {       // topometry: peak RSS 2.2-3.4 GB, ~3.6 cores on average, 7-13 min (full run, 3 subsets)
        cpus   = 8
        memory = { 16.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }

    withName: CLUSTER_COMPARE {     // HC and MES subsets: 0.4-0.6 GB peak, 7 s of compute (reads obs/obsm only)
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 15.min * task.attempt }
    }
    withName: CLUSTREE {            // 0.2 GB peak, 5 s of compute
        cpus   = 1
        memory = { 1.GB * task.attempt }
        time   = { 10.min * task.attempt }
    }

    withName: ANALYSIS {            // first guess (untimed, now including the differential expression); adjust from pipeline_info/trace.txt
        cpus   = 2
        memory = { 16.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    withName: CONSENSUS {           // not yet traced, keeps the original sizing (old scripts: 8G per core x 4)
        cpus   = 4
        memory = 32.GB
        time   = 10.min
    }

    withName: FACTORIZE {
        errorStrategy = 'retry'     // completed iterations are skipped on retry
        maxRetries    = 1
    }
}
