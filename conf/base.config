// Resource labels, used by the modules. The ucl_myriad profile owns the executor, penv, clusterOptions
// (memory per core), scratch and the container engine, so only cpus / memory / time are set here.
// memory is the TOTAL for the task: the profile divides it by cpus to get the per-core request.

// anndata setting from scripts/include.sh. The env scope is exported inside the container by Nextflow,
// which a beforeScript export (or APPTAINERENV_ on the host) did not reliably do.
env {
    ANNDATA_ALLOW_WRITE_NULLABLE_STRINGS = '1'
}

process {
    errorStrategy = 'finish'

    withLabel: process_single {     // factorize: each task runs a stride of iterations
        cpus   = 1
        memory = 2.GB
        time   = 6.h                // stride 10 x up to ~30 min per iteration, plus margin
    }
    withLabel: process_medium {     // subset, prep, combine, consensus (old scripts: 8G per core x 4)
        cpus   = 4
        memory = 32.GB
        time   = 10.min
    }
    withLabel: process_high {       // topometry (old script: 4G per core x 20)
        cpus   = 20
        memory = 80.GB
        time   = 12.h
    }

    withName: FACTORIZE {
        errorStrategy = 'retry'     // completed iterations are skipped on retry
        maxRetries    = 1
    }
}
