// Resource labels, used by the modules. The ucl_myriad profile owns the executor, penv, clusterOptions
// (memory per core), scratch and the container engine, so only cpus / memory / time are set here.
// memory is the TOTAL for the task: the profile divides it by cpus to get the per-core request.

// anndata setting from scripts/include.sh. The env scope is exported inside the container by Nextflow,
// which a beforeScript export (or APPTAINERENV_ on the host) did not reliably do.
env {
    ANNDATA_ALLOW_WRITE_NULLABLE_STRINGS = '1'
}

process {
    // retry with scaled resources on OOM / walltime kills (137-140 SGE, 143-145 signals, 104), else finish
    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 1

    withLabel: process_single {     // factorize: each task runs a stride of iterations
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 6.h * task.attempt }     // stride 10 x up to ~30 min per iteration, plus margin
    }
    withLabel: process_medium {     // subset, prep, combine: single-threaded, ~0.2-2.5 GB peak (thirsty_knuth trace)
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 15.min * task.attempt }
    }
    withLabel: process_high {       // topometry (old script: 4G per core x 20)
        cpus   = 20
        memory = 80.GB
        time   = 12.h
    }

    withName: ANALYSIS {            // sizing is a first guess (untimed); adjust from pipeline_info/trace.txt
        cpus   = 2
        memory = { 16.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    withName: CONSENSUS {           // not yet traced, keeps the original sizing (old scripts: 8G per core x 4)
        cpus   = 4
        memory = 32.GB
        time   = 10.min
    }

    withName: FACTORIZE {
        errorStrategy = 'retry'     // completed iterations are skipped on retry
        maxRetries    = 1
    }
}
